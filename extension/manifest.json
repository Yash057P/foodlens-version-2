{
  "manifest_version": 3,
  "name": "FoodLens AI",
  "version": "1.0.0",
  "description": "Identify food and get nutrition/allergen info instantly.",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open FoodLens"
  }
}

